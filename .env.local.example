# Copy to .env.local (gitignored) and fill in. Placeholders only in this file; .env.local is never committed.

# Zetaris Lightning (local Docker). The driver JAR ships with the Zetaris platform download.
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=/path/to/zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_ADMIN_USERNAME=
ZETARIS_ADMIN_PASSWORD=
# Optional reader login (a user name and a password of 8 or more characters); otherwise the gateway reads with the admin login.
ZETARIS_READER_USERNAME=
ZETARIS_READER_PASSWORD=

# SEC EDGAR fair-access policy: a declared User-Agent naming the application and its operator.
# Filled into the YOUR_APP_NAME YOUR_CONTACT_EMAIL placeholder on the wire only; never a literal in the repository.
WON_USER_AGENT="<application name> <operator contact>"
# Signs and verifies execution contracts between the agent and the gateway registrar (32 or more characters).
WON_CONTRACT_SECRET=<generate: 32 random bytes hex>

# Model: local Ollama only, no cloud calls.
OLLAMA_URL=http://127.0.0.1:11434
WON_MODEL=nemotron-3-nano:4b
WON_MODEL_FALLBACK=nemotron-3-nano:4b-q8_0
# Set to off to force think off for every job (default: think on for planning, off for the memo).
WON_THINK=

# Ports (loopback only): the gateway and the agent server with the UI.
GATEWAY_URL=http://127.0.0.1:8793
UI_PORT=8794
# Optional: the runtime data directory (runs, evidence, H-MEM, World Model, DQ file, contract ledgers); default <repo>/data.
WON_DATA_DIR=
# Optional: WON_GATEWAY_PORT (default 8793), WON_CACHE_TARGETS (comma-separated views the warm-up keeps cached),
# GATEWAY_QUERY_TIMEOUT_S (default 60), WON_MIN_AVAILABLE_RAM_MIB (model RAM guard, default 2048).

# Optional: a checkout of the Zetaris getting-started repository, read at boot to seed H-MEM with its data manifest.
ZETARIS_GETTING_STARTED_DIR=
